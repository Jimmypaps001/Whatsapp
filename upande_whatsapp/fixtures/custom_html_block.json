  "html": "<div class=\"scpn\">\n  <div class=\"scpn-title\">WhatsApp</div>\n  <div class=\"scpn-sec\">Messaging</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/whatsapp\"><span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">WhatsApp Messages</span><span class=\"scpn-sub\">Live chat console</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/bulk-whatsapp-message\"><span class=\"scpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Bulk WhatsApp</span><span class=\"scpn-sub\">Broadcast to a list</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-message\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"9\" y1=\"13\" x2=\"15\" y2=\"13\"/><line x1=\"9\" y1=\"17\" x2=\"15\" y2=\"17\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Message Log</span><span class=\"scpn-sub\">All sent &amp; received</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-templates\"><span class=\"scpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"/><line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Templates</span><span class=\"scpn-sub\">Approved Meta templates</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Notifications</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-notification\"><span class=\"scpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Notifications</span><span class=\"scpn-sub\">Event-triggered sends</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-notification-log\"><span class=\"scpn-ic\" style=\"background:rgba(239,68,68,.13);color:#dc2626\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 3v5h5\"/><path d=\"M3.05 13A9 9 0 1 0 6 5.3L3 8\"/><polyline points=\"12 7 12 12 15 14\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Notification Log</span><span class=\"scpn-sub\">Delivery &amp; failure log</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Contacts &amp; Audiences</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-contact\"><span class=\"scpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Contacts</span><span class=\"scpn-sub\">Known WhatsApp contacts</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-profiles\"><span class=\"scpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><circle cx=\"8\" cy=\"10\" r=\"2\"/><path d=\"M14 9h4M14 13h4M4.5 18a4 4 0 0 1 7 0\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Profiles</span><span class=\"scpn-sub\">Linked profile records</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-recipient-list\"><span class=\"scpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><line x1=\"3\" y1=\"6\" x2=\"3.01\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"3.01\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"3.01\" y2=\"18\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Recipient Lists</span><span class=\"scpn-sub\">Reusable audiences</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Automation</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-flow\"><span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"15\" y=\"15\" width=\"6\" height=\"6\" rx=\"1\"/><path d=\"M9 6h4a2 2 0 0 1 2 2v7\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Flows</span><span class=\"scpn-sub\">Interactive message flows</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Configuration</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-account\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22v-5\"/><path d=\"M9 8V2M15 8V2\"/><path d=\"M18 8v3a6 6 0 0 1-12 0V8z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">WhatsApp Account</span><span class=\"scpn-sub\">WABA connection</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/whatsapp-settings\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">WhatsApp Settings</span><span class=\"scpn-sub\">Tokens &amp; webhooks</span></span></a>\n  </div>\n</div>",
